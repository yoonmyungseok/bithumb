# ==============================================================================
# 빗썸 봇 전용 환경 변수 예시 (.env.bithumb)
# ==============================================================================
# 이 파일은 빗썸 봇 실행에 필요한 고유 인증 및 전용 설정입니다.
# 전략/한도/리스크 파라미터는 공통 .env 설정을 상속받으며, 필요 시 여기서 개별 오버라이드합니다.
# 실제 운영 시 이 파일을 .env.bithumb으로 복사하여 사용하세요.
# API 키·토큰은 절대로 Git 저장소에 커밋하지 마세요.
# ==============================================================================

# 빗썸 REST 주문 인증 정보입니다. 둘 중 하나라도 비어 있으면 실주문 클라이언트를 만들 수 없습니다.
BITHUMB_ACCESS_KEY=YOUR_BITHUMB_ACCESS_KEY
BITHUMB_SECRET_KEY=YOUR_BITHUMB_SECRET_KEY

# 빗썸 AI는 전용 Gemini API 키와 Groq 키를 사용하며 공용·업비트 키와 공유하지 않습니다.
BITHUMB_AI_PROVIDER=gemini
BITHUMB_GEMINI_API_KEY=YOUR_BITHUMB_GEMINI_API_KEY
BITHUMB_GROQ_API_KEY=YOUR_BITHUMB_GROQ_API_KEY

# 빗썸 알림 및 원격 명령 수신용 텔레그램 설정입니다.
TELEGRAM_BOT_TOKEN=YOUR_BITHUMB_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_BITHUMB_TELEGRAM_CHAT_ID

# 빗썸 봇 내부 API 수신 포트입니다.
BITHUMB_INTERNAL_PORT=17979
# 다른 거래소와의 REST 호출 분산을 위한 빗썸 사이클 시작 오프셋(초)입니다.
BITHUMB_CYCLE_OFFSET_SECONDS=0
# PAPER 모드 체결 시 적용할 빗썸 편도 수수료율입니다.
PAPER_FEE_RATE=0.0004
