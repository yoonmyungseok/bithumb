# 업비트 봇 환경 변수 예시입니다. 실제 .env.upbit로 복사한 뒤 비밀값을 채우세요.
# 업비트 설정은 .env와 분리해 운영하며 빗썸 인증 정보와 혼합하지 않습니다.

# 업비트 REST 주문 인증 정보입니다. 둘 중 하나라도 비어 있으면 실주문 클라이언트를 만들 수 없습니다.
# 업비트 API 접근 키입니다.
UPBIT_ACCESS_KEY=YOUR_UPBIT_ACCESS_KEY
# 업비트 API 비밀 키입니다.
UPBIT_SECRET_KEY=YOUR_UPBIT_SECRET_KEY
# 업비트 REST API 기본 주소입니다.
UPBIT_API_BASE_URL=https://api.upbit.com/v1
# 업비트 공개 시세 WebSocket 주소입니다.
UPBIT_WEBSOCKET_URL=wss://api.upbit.com/websocket/v1
# 업비트 주문·체결 전용 Private WebSocket 주소입니다.
UPBIT_PRIVATE_WEBSOCKET_URL=wss://api.upbit.com/websocket/v1/private

# 업비트 AI는 전용 Gemini 키를 우선 사용합니다. 빗썸 Groq 키와 공유하지 않습니다.
# 업비트 Gemini API 인증 키입니다.
UPBIT_GEMINI_API_KEY=YOUR_UPBIT_GEMINI_API_KEY

# 업비트 전용 알림 및 원격 명령 수신용 텔레그램 설정입니다.
# 업비트 알림용 텔레그램 봇 인증 토큰입니다.
UPBIT_TELEGRAM_BOT_TOKEN=YOUR_UPBIT_TELEGRAM_BOT_TOKEN
# 업비트 알림과 명령을 연결할 텔레그램 채팅 식별자입니다.
UPBIT_TELEGRAM_CHAT_ID=YOUR_UPBIT_TELEGRAM_CHAT_ID

# 수동 관리 종목은 자동 매매와 자동 평가에서 제외합니다. KRW-HOLO는 항상 포함해야 합니다.
# 업비트 경계에서 제외할 마켓 목록입니다.
UPBIT_EXCLUDED_MARKETS=KRW-HOLO,HOLO
# 공통 정책에서 수동 관리 종목을 제외할 마켓 목록입니다.
EXCLUDED_MANUAL_HOLDINGS=KRW-HOLO,HOLO

# 자동 선별 대상입니다. AUTO는 런타임 스크리너가 후보를 선정합니다.
# AUTO 또는 쉼표로 구분한 KRW 마켓 목록을 지정합니다.
MARKETS=AUTO
# 한 사이클에서 우선 분석할 후보 수입니다.
TOP_COUNT=3
# 24시간 거래대금 하한(원)입니다.
MIN_TRADE_VALUE=1000000000
# 후보의 최소 등락률이며 0.005는 0.5%입니다.
MIN_CHANGE_RATE=0.005
# 후보의 최대 등락률이며 0.25는 25%입니다.
MAX_CHANGE_RATE=0.25
# 분석·주문 사이클 간격(분)입니다.
INTERVAL_MINUTES=5
# 다른 거래소와의 호출 분산을 위한 업비트 사이클 시작 오프셋(초)입니다.
UPBIT_CYCLE_OFFSET_SECONDS=0

# 주문 및 포트폴리오 한도입니다. 비율은 소수(0.50) 또는 기존 퍼센트(50)를 허용합니다.
# LIVE는 실제 거래 모드이며 운영 전 PAPER 모드 사용 여부를 별도로 검토해야 합니다.
TRADING_MODE=LIVE
# 동시에 보유할 수 있는 최대 포지션 수입니다.
MAX_OPEN_POSITIONS=2
# 단일 포지션이 총 평가금액에서 차지할 최대 비율입니다.
MAX_POSITION_PCT=0.50
# 모든 포지션의 합계가 총 평가금액에서 차지할 최대 비율입니다.
MAX_TOTAL_EXPOSURE_PCT=0.95
# 단일 매수 주문의 절대 최대 금액(원)이며 0은 코드 기본 동작을 유지합니다.
MAX_ORDER_KRW=0
# PAPER 모드에서 시작할 가상 KRW 잔고입니다.
PAPER_INITIAL_KRW=1000000
# PAPER 모드 체결 시 적용할 편도 수수료율입니다.
PAPER_FEE_RATE=0.0005

# 모든 신규 BUY에 공통 적용되는 리스크 임계값입니다.
# BTC 단기 하락률이 이 값에 도달하면 신규 매수를 차단합니다.
BTC_CRASH_THRESHOLD_PCT=0.015
# 일일 누적 손실 한도 비율이며 초과 시 신규 매수를 차단합니다.
MAX_DAILY_LOSS_PCT=0.05
# 수익 포지션의 트레일링 감시를 시작할 수익률입니다.
TRAILING_START_PCT=0.02
# 최고 수익률 대비 이 비율만큼 하락하면 트레일링 청산합니다.
TRAILING_STOP_PCT=0.02

# 슬롯·모멘텀 정책입니다. 신규상장 실주문은 명시적 true 전까지 관찰 모드로 유지합니다.
# 스윙 전략에 예약할 최대 포지션 슬롯 수입니다.
UPBIT_MAX_SWING_POSITIONS=1
# 신규상장 전략에 예약할 최대 포지션 슬롯 수입니다.
UPBIT_MAX_NEW_LISTING_POSITIONS=1
# 신규상장 후보 분석 경로를 활성화합니다.
UPBIT_NEW_LISTING_ENABLED=true
# true일 때만 신규상장 전략의 실주문을 허용합니다.
UPBIT_NEW_LISTING_ENFORCEMENT=false
# 업비트 확정봉 모멘텀 돌파 후보 경로를 활성화합니다.
UPBIT_MOMENTUM_BREAKOUT_ENABLED=true
# 업비트 모멘텀 돌파 후보로 분류할 최소 등락률입니다.
UPBIT_MOMENTUM_BREAKOUT_MIN_CHANGE_RATE=0.003
# 한 사이클에서 직접 진입 검토할 최대 업비트 모멘텀 후보 수입니다.
UPBIT_MOMENTUM_BREAKOUT_MAX_CANDIDATES=2
# true면 호가 잔량·예상 슬리피지 실패 시 신규 매수를 실제로 차단합니다.
ORDERBOOK_SLIPPAGE_ENFORCEMENT=false

# 업비트 내부 API 포트입니다. 통합 대시보드는 .env의 URL 설정을 사용합니다.
# 업비트 봇 내부 API 수신 포트입니다.
UPBIT_INTERNAL_PORT=17980
# 업비트 레거시 웹 서버 수신 포트입니다.
UPBIT_WEB_PORT=7980
