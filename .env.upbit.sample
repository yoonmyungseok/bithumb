# ==============================================================================
# 업비트 봇 전용 환경 변수 예시 (.env.upbit)
# ==============================================================================
# 이 파일은 업비트 봇 실행에 필요한 고유 인증 및 전용 설정입니다.
# 전략/한도/리스크 파라미터는 공통 .env 설정을 상속받으며, 필요 시 여기서 개별 오버라이드합니다.
# 실제 운영 시 이 파일을 .env.upbit로 복사하여 사용하세요.
# API 키·토큰은 절대로 Git 저장소에 커밋하지 마세요.
# ==============================================================================

# 업비트 REST 주문 인증 정보입니다.
UPBIT_ACCESS_KEY=YOUR_UPBIT_ACCESS_KEY
UPBIT_SECRET_KEY=YOUR_UPBIT_SECRET_KEY
UPBIT_API_BASE_URL=https://api.upbit.com/v1
UPBIT_WEBSOCKET_URL=wss://api.upbit.com/websocket/v1
UPBIT_PRIVATE_WEBSOCKET_URL=wss://api.upbit.com/websocket/v1/private

# 업비트 AI는 전용 Gemini 키와 Groq 키를 사용하며 빗썸 키와 공유하지 않습니다.
UPBIT_GEMINI_API_KEY=YOUR_UPBIT_GEMINI_API_KEY
UPBIT_GROQ_API_KEY=YOUR_UPBIT_GROQ_API_KEY

# 업비트 전용 알림 및 원격 명령 수신용 텔레그램 설정입니다.
UPBIT_TELEGRAM_BOT_TOKEN=YOUR_UPBIT_TELEGRAM_BOT_TOKEN
UPBIT_TELEGRAM_CHAT_ID=YOUR_UPBIT_TELEGRAM_CHAT_ID

# 업비트 수동 관리 종목은 자동 매매와 자동 평가에서 영구 제외합니다. KRW-HOLO는 항상 포함해야 합니다.
UPBIT_EXCLUDED_MARKETS=KRW-HOLO,HOLO
EXCLUDED_MANUAL_HOLDINGS=KRW-HOLO,HOLO

# 업비트 봇 내부 API 및 레거시 웹 포트입니다.
UPBIT_INTERNAL_PORT=17980
UPBIT_WEB_PORT=7980
# 다른 거래소와의 REST 호출 분산을 위한 업비트 사이클 시작 오프셋(초)입니다.
UPBIT_CYCLE_OFFSET_SECONDS=15
# 한 사이클 런타임 분석·캔들 prefetch 상한 (기본 6)
UPBIT_MAX_CYCLE_MARKETS=6
# PAPER 모드 체결 시 적용할 업비트 편도 수수료율입니다.
PAPER_FEE_RATE=0.0005
