# ==============================================================================
# 빗썸 & 업비트 통합 퀀트 트레이딩 봇 - 공통 환경 변수 예시 (.env)
# ==============================================================================
# 이 파일은 두 거래소 봇(Bithumb, Upbit)과 통합 대시보드가 공유하는 공통 인프라 및
# 공통 트레이딩 전략/리스크 설정입니다.
#
# 계층 구조 안내:
# 1. .env          : 공통 인프라(대시보드, 내부 API URL, 동기화) + 공통 전략/한도/리스크
# 2. .env.bithumb  : 빗썸 전용 설정 (API 키, Gemini/Groq 키, 전용 포트 등)
# 3. .env.upbit    : 업비트 전용 설정 (API 키, Gemini/Groq 키, 전용 포트, 격리 종목 등)
#
# 각 거래소 봇은 구동 시 .env(공통)를 먼저 읽은 뒤, 거래소 전용 .env.* 로 값을 오버라이드합니다.
# API 키·토큰·비밀번호는 절대로 Git 저장소에 커밋하지 마세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 통합 대시보드 게이트웨이 및 내부 API 라우팅 설정
# ------------------------------------------------------------------------------
# 통합 대시보드가 바인딩할 호스트 IP입니다. (로컬: 127.0.0.1, 외부/VPN: 0.0.0.0 또는 Tailscale IP)
DASHBOARD_HOST=100.76.22.126
# 통합 대시보드 웹 접속 포트입니다.
DASHBOARD_PORT=7979
# 대시보드의 상태 변경/명령 요청을 인증할 긴 무작위 비밀값입니다. (비우면 명령 차단)
DASHBOARD_ACTION_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET

# 통합 대시보드가 빗썸 봇 내부 API에 접속할 엔드포인트 URL입니다.
BITHUMB_API_URL=http://127.0.0.1:17979
# 통합 대시보드가 업비트 봇 내부 API에 접속할 엔드포인트 URL입니다.
UPBIT_API_URL=http://127.0.0.1:17980

# ------------------------------------------------------------------------------
# 2. 원격 서버 동기화 설정 (sync_manager.py 사용 시)
# ------------------------------------------------------------------------------
# 동기화 대상 원격 리눅스 서버 호스트 IP/도메인입니다.
REMOTE_SERVER_HOST=YOUR_REMOTE_SERVER_HOST
# 원격 서버 SSH 포트입니다.
REMOTE_SERVER_PORT=22
# 원격 서버 SSH 로그인 사용자 계정입니다.
REMOTE_SERVER_USER=YOUR_REMOTE_SERVER_USER
# 원격 서버 SSH 로그인 비밀번호입니다. (SSH 키 인증 사용 시 비워둘 수 있음)
REMOTE_SERVER_PASS=YOUR_REMOTE_SERVER_PASSWORD
# 원격 서버 상의 프로젝트 배포 절대 경로입니다.
REMOTE_SERVER_DIR=/home/trader/bithumb-bot

# ------------------------------------------------------------------------------
# 3. 공통 트레이딩 전략 및 시장 스크리닝 설정
# ------------------------------------------------------------------------------
# 분석·주문 사이클 간격(분)입니다.
INTERVAL_MINUTES=5
# 자동 선별 대상입니다. AUTO는 런타임 스크리너가 후보를 선정합니다.
MARKETS=AUTO
# 한 사이클에서 우선 분석할 후보 수입니다.
TOP_COUNT=3
# 24시간 거래대금 하한(원)입니다.
MIN_TRADE_VALUE=1000000000
# 후보의 최소 등락률이며 0.005는 0.5%입니다.
MIN_CHANGE_RATE=0.005
# 후보의 최대 등락률이며 0.25는 25%입니다.
MAX_CHANGE_RATE=0.25

# ------------------------------------------------------------------------------
# 4. 공통 주문 및 포트폴리오 한도 설정
# ------------------------------------------------------------------------------
# REAL(또는 LIVE)은 실제 거래 모드이며 운영 전 PAPER 모드 사용 여부를 별도로 검토해야 합니다.
TRADING_MODE=REAL
# 단일 주문의 최소 금액(원)입니다.
MIN_ORDER_KRW=5000
# 동시에 보유할 수 있는 최대 포지션 수입니다.
MAX_OPEN_POSITIONS=3
# 단일 포지션이 총 평가금액에서 차지할 최대 비율입니다.
MAX_POSITION_PCT=0.35
# 모든 포지션의 합계가 총 평가금액에서 차지할 최대 비율입니다.
MAX_TOTAL_EXPOSURE_PCT=0.90
# 단일 매수 주문의 절대 최대 금액(원)입니다.
MAX_ORDER_KRW=20000000
# PAPER 모드에서 시작할 가상 KRW 잔고입니다.
PAPER_INITIAL_KRW=1000000

# ------------------------------------------------------------------------------
# 5. 공통 슬롯 정책 및 모멘텀 돌파 설정
# ------------------------------------------------------------------------------
# 스윙 전략에 예약할 최대 포지션 슬롯 수입니다.
MAX_SWING_POSITIONS=1
# 신규상장 전략에 예약할 최대 포지션 슬롯 수입니다.
MAX_NEW_LISTING_POSITIONS=1
# 신규상장 후보 분석 경로 활성화 여부입니다.
NEW_LISTING_ENABLED=true
# true일 때만 신규상장 전략의 실주문을 허용합니다. (기본 관찰 모드)
NEW_LISTING_ENFORCEMENT=false

# 확정봉 모멘텀 돌파 후보 경로 활성화 여부입니다.
MOMENTUM_BREAKOUT_ENABLED=true
# 모멘텀 돌파 후보로 분류할 최소 등락률입니다.
MOMENTUM_BREAKOUT_MIN_CHANGE_RATE=0.003
# 한 사이클에서 직접 진입 검토할 최대 모멘텀 후보 수입니다.
MOMENTUM_BREAKOUT_MAX_CANDIDATES=2

# ------------------------------------------------------------------------------
# 6. 공통 리스크 관리 및 호가 안전망
# ------------------------------------------------------------------------------
# BTC 단기 하락률이 이 값에 도달하면 신규 매수를 차단합니다.
BTC_CRASH_THRESHOLD_PCT=0.015
# 일일 누적 손실 한도 비율이며 초과 시 신규 매수를 차단합니다.
MAX_DAILY_LOSS_PCT=0.05
# 수익 포지션의 트레일링 감시를 시작할 수익률입니다.
TRAILING_START_PCT=0.03
# 최고 수익률 대비 이 비율만큼 하락하면 트레일링 청산합니다.
TRAILING_STOP_PCT=0.02
# true면 호가 잔량·예상 슬리피지 실패 시 신규 매수를 실제로 차단합니다.
ORDERBOOK_SLIPPAGE_ENFORCEMENT=false
